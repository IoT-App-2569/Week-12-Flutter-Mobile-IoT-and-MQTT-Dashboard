# Copy this file to ".env" and fill in your own values. ".env" is ignored by git.
# ESP32 supports 2.4 GHz Wi-Fi only (no 5 GHz, no WPA2-Enterprise).
WIFI_SSID=your-wifi-name
WIFI_PASS=your-wifi-password
# IPv4 of the laptop running Mosquitto (check with ipconfig on the same Wi-Fi)
MQTT_BROKER_URI=mqtt://192.168.1.100:1883
# 1 = generate random voltage (no potentiometer needed), 0 = read the real ADC pin
SIMULATE_ADC=1
