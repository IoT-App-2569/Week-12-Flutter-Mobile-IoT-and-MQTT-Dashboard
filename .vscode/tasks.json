{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "MQTT: Start Mosquitto Broker",
            "type": "shell",
            "command": "mosquitto -c mosquitto.conf -v",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "MQTT: Subscribe All Topics (CLI Monitor)",
            "type": "shell",
            "command": "mosquitto_sub -h 127.0.0.1 -p 1883 -t \"#\" -v",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        },
        {
